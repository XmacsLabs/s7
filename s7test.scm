;;; replace built-in object->string:
(define (object->string . args)
  (let ((obj (car args)))
    (if (not (byte-vector? obj))
	(apply #_object->string args)
	(let ((len (length obj)))
	  (if (zero? len)
	      "#u()"
	      (with-output-to-string
		(lambda ()
		  (display "#u(")
		  (do ((i 0 (+ i 1)))
		      ((= i (- len 1)))
		    (format () "#o~O " (obj i)))
		  (format () "#o~O)" (obj (- len 1))))))))))

