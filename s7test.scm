  (let ((happy #t))
    (do ((i 2 (+ i 1)))
	((or (not happy) (> i top-exp)))
      (let* ((val1 (/ (- (expt 2 i) 1) 2))
	     (val2 (expt 2 (- i 1)))
	     (fv (floor val1))
	     (rv (round val1))
	     (cv (ceiling val1))
	     (tv (truncate val1)))
	(if (not (= fv (- val2 1)))
	    (begin (set! happy #f) (format #t ";(floor ~S) = ~S?~%" val1 fv)))
	(if (not (= cv val2))
	    (begin (set! happy #f) (format #t ";(ceiling ~S) = ~S?~%" val1 cv)))
	(if (not (= tv (- val2 1)))
	    (begin (set! happy #f) (format #t ";(truncate ~S) = ~S?~%" val1 tv)))
	(if (not (= rv val2))
