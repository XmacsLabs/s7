	  (if (not (chker y))
	      (format #t ";(random ~A) -> ~A?~%" range y))
	  (let ((iy (min 99 (floor (* 100 (/ y range))))))
	    (vector-set! hits iy (+ 1 (vector-ref hits iy))))))
      (let ((sum 0.0)
	    (p (/ n 100.0)))
	(do ((i 0 (+ 1 i)))
	    ((= i 100) sum)
	  (let ((num (- (vector-ref hits i) p)))
	    (set! sum (+ sum (/ (* num num) p))))))))

