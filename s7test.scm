(let ()
  ;; -------- Ely Bandersky (translated from python) --------

  (define (fib-tail n0)
    (let fibber ((n n0)
		 (ac1 1)
		 (ac2 1))
      (if (= n 0)
	  ac1
	  (fibber (- n 1) (+ ac1 ac2) ac1))))
  (test (fib-tail 6) 21)

  (define (fact-tail n0)
    (let facter ((n n0)
		 (result 1))
      (if (= n 0)
	  result
	  (facter (- n 1) (* n result)))))
  (test (fact-tail 6) 720)

  (define (fib-iter n0)
    (let ((ac1 1)
	  (ac2 1))
      (do ((n n0 (- n 1)))
	  ((<= n 2)
	   ac1)
	(let ((ac11 ac1))
	  (set! ac1 (+ ac1 ac2))
	  (set! ac2 ac11)))))
  (test (fib-iter 6) 8)

  (define (fact-cps n cont)
    (if (= n 0)
	(cont 1)
	(fact-cps (- n 1) (lambda (value)
			    (cont (* n value))))))
  (fact-cps 6 (lambda (n) (test n 720)))

  (define (fib-cps n cont)
    (if (< n 2)
	(cont 1)
	(fib-cps (- n 1) (lambda (value)
			   (fib-cps (- n 2)
				    (lambda (value2)
				      (cont (+ value value2))))))))
  (fib-cps 6 (lambda (n) (test n 13)))

  (define (trampoline f . args)
    (let ((v (apply f args)))
      (do ()
	  ((not (aritable? v 0))
	   v)
	(set! v (v)))))

  (define (fact-cps-chunked n cont)
    (if (= n 0)
	(cont 1)
	(lambda ()
	  (fact-cps-chunked (- n 1)
			    (lambda (value)
			      (lambda ()
				(cont (* n value))))))))
  (fact-cps-chunked 6 (lambda (n) (test n 720))))

