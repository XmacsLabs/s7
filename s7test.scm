				 (caddr binding)))
			  fields))
	    (gsetters (gensym))
	    (glet (gensym)))
	`(let ((,gsetters (list ,@setters))
	       (,glet (inlet ,@(map (lambda (binding)
				      `(cons ',(car binding) ,(cadr binding)))
