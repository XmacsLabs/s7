      (((if (not #<test:>) #<body:>)) (cons 'unless (list '#<test> '#<body>)))
      (((if #<test:> (begin #<body:...>))) (cons 'when (cons '#<test> #<body>)))
      (((if #<test:> #<body:>)) (cons 'when (list '#<test> '#<body>)))))
