(define (hash-table-equalizer h)
  (let ((data (object->let h)))
    (and (defined? 'function data #t)
	 (let-ref data 'function))))

(define (hash-table-key/value-types h)
  (let* ((data (object->let h))
	 (sig (and (defined? 'signature data #t)
		   (let-ref data 'signature))))
    (and (pair? sig)
	 (list (caddr sig)
	       (car sig)))))

