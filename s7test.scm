;;; this hits the heap-overflow code, checking that we can actually keep going and run (*s7* 'memory-usage)
(let-temporarily (((*s7* 'max-heap-size) (ash 1 20))
		  ((*s7* 'max-list-length) (ash 1 24)))
  (define (bigger)
    (catch #t (lambda () (make-list (* 1234 512)))
	   (lambda (type info)
	     (when (eq? type 'heap-too-big)
	       (format *stderr* "heap overflow: ~S~%" (apply format #f info))
	       (pretty-print (*s7* 'memory-usage) *stderr*)
	       (newline *stderr*)
	       (format *stderr* "gc -> ")
	       (do ((x 0.0) (i 0 (+ i 1))) ((= i 256)) (set! x (complex i i))) ; clear temps
	       (gc) (gc)
	       (pretty-print (*s7* 'memory-usage) *stderr*)
	       (newline *stderr*)
	       (display "stopping t725...\n" *stderr*)
	       (abort))))) ; to keep Linux from killing the X server!
  (bigger)
  (bigger))
