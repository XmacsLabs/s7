(define (symbol->value-anywhere sym)
  (if (defined? sym)
      (symbol->value sym)
      (letrec ((libsearch
		(lambda (sym libs)
		  (if (pair? libs)
		      (if (defined? sym (cdar libs))
			  (symbol->value sym (cdar libs))
			  (libsearch sym (cdr libs)))
		      #<undefined>))))
	(libsearch sym *libraries*))))

(let ((st (symbol-table)))
  (for-each (lambda (s)
	      (catch #t
		(lambda ()
		  (let ((f (symbol->value-anywhere s)))
		    (if (procedure? f)
			(let ((sig (signature f))
			      (ari (arity f)))
			  (if (and sig (not (pair? sig)))
			      (format *stderr* "signature ~A: ~A~%" s sig))
			  (when (pair? sig)
			    (if (and (pair? ari)
				     (> (cdr ari) (- (length sig) 1))
				     (or (< (cdr ari) 20)
					 (< (length sig) 10))
				     (not (eq? s 'make-hook)))
				(format *stderr* "signature is missing arg type: ~A: ~A ~A~%~%" s ari sig))
			    (when (and (pair? sig)
				       (pair? (car sig))
				       (or (null? (cdar sig))
					   (memq #t (car sig))
					   (let search ((lst (car sig)))
					     (and (pair? lst)
						  (or (memq (car lst) (cdr lst))
						      (search (cdr lst)))))))
			      (format *stderr* "arity/sig mismatch? ~A: ~A?~%" s sig)))))))
		(lambda args #f)))
	    st))


