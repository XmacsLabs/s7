	(define* (nbutlast list (n 1)) ; sacla
	  (if (null? list)
	      ()
	      (let ((length (do ((p (cdr list) (cdr p))
				 (i 1 (+ i 1)))
				((not (pair? p)) i))))
		(if (> length n)
		    (do ((1st (cdr list) (cdr 1st))
			 (2nd list 1st)
			 (count (- length n 1) (- count 1)))
			((zero? count)
			 (set-cdr! 2nd ())
			 list))
