		  (let ((tag (car clause)))
		    (set! base `(lambda ()
				  (catch ',(if (eq? tag 'else) #t tag)
				    ,base
				    ,@(cdr clause))))))
		clauses)
      (caddr base)))

  (test (catch-case ((wrong-type-arg   (lambda args (format #t "got a bad arg~%") -1))
