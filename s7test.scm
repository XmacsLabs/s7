  (define (simple-sort! seq func)
    (let ((dims #f))
      (when (and (vector? seq)
		 (> (vector-rank seq) 1))
	(set! dims (vector-dimensions seq))
	(set! seq (subvector seq)))
      (let ((len (length seq)))
	(do ((i 0 (+ i 1)))
	    ((= i len))
	  (do ((j 0 (+ j 1)))
	      ((= j len))
	    (if (func (seq i) (seq j))
		(swap! (seq i) (seq j)))))
	(if dims
	    (subvector seq 0 len dims)
	    seq))))
  
