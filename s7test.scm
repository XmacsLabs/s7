    (list (catch #t
       (lambda () (set! (logand 11) 12))  ;set_pair3 safe->unsafe(c_func), 2 args to catch "catch: not enough arguments: (catch 11 12)"
       (lambda (type info) 10))))
  (func)
  (test (vector (func)) #((10))))

