    (define (func)
      (catch #t
	(lambda () (set! (f1 2) 321))  ; clo->c_func -> error: "set!: two arguments? (abs 2 321), abs is (setter f1)"
	(lambda (type info) 2)))
  (func)
  (test (func) 2)))

(let ()
