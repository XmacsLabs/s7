(define-expansion (reader-when test . true)
  (if (null? true)
      (error 'syntax-error "reader-when has no body?")
      (let ((test-val (eval test)))
	(if test-val
	    (apply values true)
	    (values)))))

(define-expansion (reader-case select . clauses)
  (if (null? clauses)
      (error 'syntax-error "reader-case has no clauses")
      (let ((key (eval select)))
	(call-with-exit
	 (lambda (return)
	   (for-each
	    (lambda (clause)
	      (if (or (eq? (car clause) 'else)
		      (memv key (car clause)))
		  (return (apply values (cdr clause)))))
	    clauses)
	   (values))))))

