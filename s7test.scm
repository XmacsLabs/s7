(let ()
  (require case.scm)
  (define (scase x)
    (case* x
      ((a b) 'a-or-b)
      ((1 2/3 3.0) => (lambda (a) (* a 2)))
      ((pi) 1 123)
      (("string1" "string2"))
      ((#<symbol?>) 'symbol!)
      (((+ x #<symbol?>)) 'got-list)
      ((#(1 x 3)) 'got-vector)
      (((+ #<>)) 'empty)
      (((* #<x:symbol?> #<x>)) 'got-label)
      (((#<> #<x:> #<x>)) 'repeated)
      (((#<symbol?> #<symbol?>)) 'two)
      (((#<x:> #<x>)) 'pair)
      ((#(#<x:> #<x>)) 'vector)
      ((#(#<symbol?> #<...> #<number?>)) 'vectsn)
      ((#(#<...> #<number?>)) 'vectstart)
      ((#(#<string?> #<char-whitespace?> #<...>)) 'vectstr)
      (else 'oops)))

  (test (scase 3.0) 6.0)
  (test (scase 'pi) 123)
