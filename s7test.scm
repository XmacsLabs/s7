	  (((#<x:> #<x> #<...>))
	   (uniq-1 (cdr lst) new-lst))
	  (else
	   (uniq-1 (cdr lst) (cons (car lst) new-lst)))))
      (lambda (lst)
	(uniq-1 lst ()))))

  (test (uniquify '(a a b b b b a a c c)) '(a b a c))
