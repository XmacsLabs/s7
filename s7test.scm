   (define (frame2) (frame1 1))
   (catch #t
     (lambda ()
       (let ((result (frame1 1)))
         (format *stderr* "frame1 (2): ~S?\n" result)))
     (lambda (type info)
       (unless (and (eq? type 'unbound-variable)
                    (string=? (substring (apply format #f info) 0 20) "unbound variable _p_"))
         (format *stderr* "frame1 (2): ~S ~S~%" type (apply format #f info)))))
   (catch #t
