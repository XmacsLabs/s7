	(lambda (p)
	  (format p "
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <math.h>

#include \"s7.h\"
static s7_scheme *s7;

/* c-object tests */
typedef struct {
  size_t size;
  double *data;
} g_block;

