    (if (< data-loc 10)
	(begin
	  (set! (data data-loc) arg)
	  (set! data-loc (+ data-loc 1))
	  (yield)
	  (process (+ arg 1)))
	(i-run)))

  (fork process 0)
  (fork process 10)
