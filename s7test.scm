;;; C-style case
(define-macro (switch selector . clauses)
  `(call-with-exit
    (lambda (break)
      (case ,selector
	,@(do ((clause clauses (cdr clause))
	       (new-clauses ()))
	      ((null? clause) (reverse new-clauses))
	    (set! new-clauses (cons `(,(caar clause)
				      ,@(cdar clause)
				      ,@(map (lambda (nc)
					       (apply values (cdr nc)))
					     (if (pair? clause) (cdr clause) ())))
				    new-clauses)))))))

