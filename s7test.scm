(test (syntax? quote) #t)
(test (equal? 'quote #_quote) #f)
(test (equal? quote #_quote) #t)
(test (equal? '#f (quote #f)) #t)
(test (equal? '(quote #f) '(#_quote #f)) #f)        ; symbol quote != #_quote
