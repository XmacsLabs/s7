  (let ((v (make-int-vector 1))
	(a #f))
    (set! (v 0) 1)
    (tvmax+loc v)
    (do ((i 0 (+ i 1))) ((= i 1)) (set! a (tvmax+loc v)))
    (test a '(1 0))))
