(define (tvmax+loc vect) ; has to be global to hit the code
  (let ((len (length vect))
	(mx 0.0)
	(loc 0))
    (do ((i 0 (+ i 1)))
	((= i len)
	 (list mx loc))
      (when (> (abs (vect i)) mx)
	(set! mx (vect i))
	(set! loc i)))))
