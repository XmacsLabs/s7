	(let ()
	  (define* (nsubstitute-if new-item test sequence from-end (start 0) end count (key identity))
	    (if (and (number? count)
		     (not (positive? count)))
		sequence
		(let* ((len (length sequence))
		       (nd (or (and (number? end) end) len))) ; up to but not including end
		  (if (< nd start)
		      (error 'out-of-range "~A :start ~A is greater than ~A ~A" (*function* (curlet)) start (if end ":end" "length") nd))
		  (let ((cur-count 0))
		    (if (not (number? count))
			(set! count len))
		    (if (not from-end)
			(do ((i start (+ i 1)))
			    ((or (= cur-count count)
				 (= i nd))
			     sequence)
			  (if (test (key (sequence i)))
			      (begin
				(set! cur-count (+ cur-count 1))
				(set! (sequence i) new-item))))
			(do ((i (- nd 1) (- i 1)))
			    ((or (= cur-count count)
				 (< i start))
			     sequence)
			  (if (test (key (sequence i)))
			      (begin
				(set! cur-count (+ cur-count 1))
				(set! (sequence i) new-item)))))))))

