(define (reinvert n op1 op2 arg)
  (let ((body (op2 (op1 arg))))
    (do ((i3 1 (+ i3 1)))
	((= i3 n) body)
      (set! body (op2 (op1 body))))))

(define (recompose n op arg)
  (define (recompose-1 n)
    (if (= n 1)
	(op arg)
	(op (recompose-1 (- n 1)))))
  (recompose-1 n))

