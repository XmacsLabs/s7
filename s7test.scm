	  (cont ()))))

  (define (fork fn arg)
    (set! readyList
	  (append readyList
		  (cons
		   (lambda (x)
		     (fn arg)
		     (i-run))
		   ()))))

  (define (yield)
    (call-with-current-continuation
     (lambda (thisCont)
       (set! readyList
	     (append readyList
		     (cons thisCont ())))
       (let ((cont (car readyList)))
	 (set! readyList (cdr readyList))
	 (cont ())))))

