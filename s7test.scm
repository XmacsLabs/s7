(let ()
  (define-macro (old-and-let* vars . body) ; from guile/1.8/ice-9/and-let-star.scm

  (define (expand vars body)
    (cond
     ((null? vars)
      (if (null? body)
	  #t
	  `(begin ,@body)))
     ((pair? vars)
      (let ((exp (car vars)))
        (cond
         ((pair? exp)
          (cond
           ((null? (cdr exp))
            `(and ,(car exp) ,(expand (cdr vars) body)))
           (else
            (let ((var (car exp)))
              `(let (,exp)
                 (and ,var ,(expand (cdr vars) body)))))))
         (else
          `(and ,exp ,(expand (cdr vars) body))))))
     (else
      (error 'wrong-type-arg "not a proper list" vars))))

  (expand vars body))

  (test (old-and-let* ((hi 3) (ho #f)) (+ hi 1)) #f))

