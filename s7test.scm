(define (tok? otst ola)
  (let* ((data #f)
	 (result (catch #t ola
			(lambda args
			 (set! data args)
			 'error))))
    (if (or (not result)
	    (eq? result 'error))
	(format #t "~A: ~A got ~S ~A~%~%" (port-line-number) otst result (or data "")))))

